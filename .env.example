APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,https://sciscope.uk,https://www.sciscope.uk
DATABASE_URL=postgresql+psycopg://sciscope:sciscope@localhost:5432/sciscope
AUTH_SESSION_COOKIE_NAME=sciscope_session
AUTH_SESSION_COOKIE_DOMAIN=
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SESSION_SECURE=false
AUTH_SESSION_SAMESITE=lax
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GITHUB_AUTH_MODE=disabled
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITLAB_AUTH_MODE=disabled
GITLAB_BASE_URL=https://gitlab.com
GITLAB_SERVICE_ACCOUNT_TOKEN=
AI_PLANNER_MODE=bootstrap
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=20
SEMANTIC_CATALOG_ENABLED=false
SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_EMBEDDING_DIMENSIONS=1536
SEMANTIC_EMBEDDING_BATCH_SIZE=100
SEMANTIC_EMBEDDING_MAX_INPUT_CHARS=6000
SEMANTIC_EMBEDDING_BATCH_MAX_CHARS=40000
SEMANTIC_CATALOG_QUERY_LIMIT=20
SEMANTIC_CATALOG_PROFILE_LIMIT=20
SEMANTIC_CATALOG_MIN_SIMILARITY=0.72
