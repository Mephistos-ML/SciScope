# Local generated graphics and design drafts; reusable sources live in docs/brand
/output/

# Local NASA source bytes; provenance and small study tables are tracked
/benchmarks/data/nasa/*
!/benchmarks/data/nasa/manifest.json
/benchmarks/data/study/run-*/repositories.jsonl
/benchmarks/data/study/run-*/evidence.jsonl
/benchmarks/data/study/run-*/features.jsonl
/benchmarks/data/study/run-*/.generation.lock
/benchmarks/data/study/run-*/.generation-checkpoint.json
/benchmarks/data/study/run-*/.queries.jsonl-*
/benchmarks/data/study/run-*/.manifest.json-*
/benchmarks/data/study/run-*/..generation-checkpoint.json-*

# Reproducible experiment output
/benchmarks/results/runs/
/benchmarks/results/exports/

# Local GitHub collection responses, resumable checkpoints and summaries
/benchmarks/data/study/run-*/github/
/benchmarks/data/study/run-*/.repositories.jsonl-*
/benchmarks/data/study/run-*/.evidence.jsonl-*
/benchmarks/data/study/run-*/.features.jsonl-*

# Archived collection formats and temporary offline rebuilds
/benchmarks/results/collection-archives/
/benchmarks/data/study/run-*/.collection-rebuild-*/

# Local audit coordination and interrupted atomic writes
/benchmarks/results/audits/*/*.lock
/benchmarks/results/audits/*/.*.json-*

# Paired domain generation coordination and atomic-write temporary files
/benchmarks/data/study/run-*/.domain-generation.lock
/benchmarks/data/study/run-*/.generation.json-*

# Shared pipeline coordination and atomic execution preparation
/benchmarks/data/study/run-*/.pipeline.lock
/benchmarks/data/study/run-*/.execution.json-*
